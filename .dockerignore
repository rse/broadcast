#   secrets (never travel into an image layer)
.env

#   version control and tooling metadata
.git
.github
.ase
.claude
.idea

#   host-side build artifacts (they are regenerated inside the image, and
#   would otherwise shadow the container's own Linux-native installation)
node_modules
src/*/node_modules
src/*/dst
tmp

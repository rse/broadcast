##
##  Run with:
##  $ docker compose --env-file .env -f etc/broadcast.composefile up -d
##
##  The "--env-file" is required, because the MQTT credentials of the
##  "broadcast" service are interpolated from the very same JUNCTION_*
##  variables which also fill the empty "pass" fields of the Junction
##  configuration in "etc/junction-server.yaml".
##

name: broadcast-${BROADCAST_INSTANCE:-dv}

services:
    #   the ingress: NFTables router, HAProxy reverse proxy,
    #   Mosquitto broker and Junction gateway in a single container
    junction:
        image:          ghcr.io/rse/junction:0.9.10-20260727
        container_name: broadcast-${BROADCAST_INSTANCE:-dv}-junction
        restart:        always
        command:        [ "-L", "info", "-c", "/app/etc/junction-server.yaml", "-e", "/app/etc/.env" ]
        network_mode:   host
        cap_add:
            -   NET_ADMIN
            -   NET_RAW
        volumes:
            -   type:      bind
                source:    ./junction-server.yaml
                target:    /app/etc/junction-server.yaml
                read_only: true
            -   type:      bind
                source:    ../.env
                target:    /app/etc/.env
                read_only: true
            -   type:      volume
                source:    junction
                target:    /app/var

    #   the application: Broadcast server (and its static client content)
    broadcast:
        image:          ghcr.io/rse/broadcast:latest
        container_name: broadcast-${BROADCAST_INSTANCE:-dv}-broadcast
        restart:        always
        network_mode:   host
        depends_on:
            database:
                condition: service_healthy
            junction:
                condition: service_started
        environment:
            BROADCAST_LOG_LEVEL:      info
            BROADCAST_WORKERS:        4
            BROADCAST_ADMIN_USERNAME: admin
            BROADCAST_ADMIN_PASSWORD: admin
            BROADCAST_DIRECTORY:      /app/lib/client
            BROADCAST_MQTT_URL:       ws://service:${JUNCTION_BROKER_PR_BACKEND_PASS}@127.0.0.1:10280/
            BROADCAST_DB_URL:         postgres://broadcast:broadcast@127.0.0.1:${BROADCAST_DB_PORT:-5432}/broadcast

    #   the persistence: PostgreSQL database
    database:
        image:          postgres:18.4-alpine3.24
        container_name: broadcast-${BROADCAST_INSTANCE:-dv}-database
        restart:        always
        shm_size:       128mb
        environment:
            POSTGRES_USER:     broadcast
            POSTGRES_PASSWORD: broadcast
            POSTGRES_DB:       broadcast
        ports:
            -   "127.0.0.1:${BROADCAST_DB_PORT:-5432}:5432"
        healthcheck:
            test:     [ "CMD-SHELL", "pg_isready -U broadcast -d broadcast" ]
            interval: 10s
            timeout:  5s
            retries:  5
        volumes:
            -   type:   volume
                source: database
                target: /var/lib/postgresql
            -   type:   tmpfs
                target: /dev/shm
                tmpfs:
                    size: 134217728 # 128*2^20 bytes = 128Mb

volumes:
    junction:
        name: broadcast-${BROADCAST_INSTANCE:-dv}-junction
    database:
        name: broadcast-${BROADCAST_INSTANCE:-dv}-database

